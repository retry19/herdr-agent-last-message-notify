# Copy this file to the config directory of the plugin:
#   cp .env.example "$(herdr plugin config-dir agent-last-message-notify)/.env"

# Agent states that send a notification. Separate the states with commas.
NOTIFY_STATUSES=done,blocked

# Time in milliseconds to wait before the notification. If the state changes in this time, the plugin does not send it.
NOTIFY_DELAY_MS=1000

# Maximum number of characters of the agent message. Set 0 to show the full message.
NOTIFY_MAX_CHARS=300

# Set 1 to also send a notification for the pane that you look at now.
NOTIFY_WHEN_FOCUSED=0

# Case of the notification title: none (claude finished) or title (Claude Finished).
NOTIFY_TITLE_CASE=none

# Set 0 to hide the workspace number in the location line.
NOTIFY_SHOW_WORKSPACE_NUMBER=1

# Text between the parts of the location line. Use quotes to keep spaces.
NOTIFY_LOCATION_SEPARATOR=" · "

# Text after the location line, for example ":". The plugin adds it only when a message follows.
NOTIFY_LOCATION_SUFFIX=

# Notification backend: auto, notify-send, osascript, or herdr.
NOTIFY_BACKEND=auto

# Application name and icon for notify-send.
NOTIFY_APP_NAME=Herdr
NOTIFY_ICON=

# Urgency of notify-send when the agent needs input: low, normal, or critical.
NOTIFY_URGENCY_BLOCKED=critical

# Set 1 to write the last event to last-invocation.json in the state directory.
NOTIFY_DEBUG=0
